import pandas as pd
customers = pd.read_excel('Documents/PROJECT.xlsx', sheet_name='Customers')
print(customers.shape)

products = pd.read_excel(r'C:\Users\mahadev\OneDrive\Documents\PROJECT.xlsx', sheet_name='Products')
Orders = pd.read_excel(r'C:\Users\mahadev\OneDrive\Documents\PROJECT.xlsx', sheet_name='Orders')
Payments = pd.read_excel(r'C:\Users\mahadev\OneDrive\Documents\PROJECT.xlsx', sheet_name='Payments')
Delivery = pd.read_excel(r'C:\Users\mahadev\OneDrive\Documents\PROJECT.xlsx', sheet_name='Delivery')

print(products.shape)
print(Orders.shape)
print(Payments.shape)
print(Delivery.shape)

print(Orders[Orders['Discount']>1])
print(Orders[Orders['Quantity']<=0])

Orders = Orders[Orders['Quantity'] > 0]
print(Orders.shape)

Orders.loc[Orders['Discount'] > 1, 'Discount'] = 1
print(Orders[Orders['Discount'] > 1])

print(customers['State'].unique())

customers['State'] = customers['State'].str.title()
print(customers['State'].unique())


print(customers['City'].unique())

customers['City'] = customers['City'].replace('Unknow', 'Unknown')
print(customers['City'].unique())

print(Delivery[Delivery['Delivery_Date'].isnull()]['Delivery_Status'].value_counts())

Delivery['Date_Issue_Flag'] = 'OK'
Delivery.loc[(Delivery['Delivery_Status'] == 'Delivered') & (Delivery['Delivery_Date'].isnull()), 'Date_Issue_Flag'] = 'Delivered but date missing'

print(Delivery['Date_Issue_Flag'].value_counts())

df=Orders.merge(customers, on='Customer_ID', how='left')
print(df.shape)
print(df.columns.tolist())

print(df[['Unnamed: 14', 'Unnamed: 15']].head(10))

print(df['Unnamed: 15'].describe())

df = df.rename(columns={'Unnamed: 15': 'Order_Count'})
df = df.drop(columns=['Unnamed: 14'])
print(df.columns.tolist())

df = df.merge(products, on='Product_ID', how='left')
print(df.shape)
print(df.columns.tolist())

df = df.drop(columns=['Selling_Price_y', 'Cost_Price_y'])
df = df.rename(columns={'Selling_Price_x': 'Selling_Price', 'Cost_Price_x': 'Cost_Price'})
print(df.columns.tolist())

df = df.merge(Payments, on='Order_ID', how='left')
df = df.merge(Delivery, on='Order_ID', how='left')
print(df.shape)
print(df.columns.tolist())

df = df.rename(columns={
    'Data_Quality_Flag_x': 'Order_Quality_Flag',
    'Data_Quality_Flag_y': 'Delivery_Quality_Flag'
})
print(df.columns.tolist())

print(df.columns.tolist())

df.info()
print("\n---Shape---")
print(df.shape)

print("\n--- Summary Statistics (Numeric Columns) ---")
df.describe().T

pd.set_option('display.max_columns', None)
pd.set_option('display.width', None)

print(df.describe().T)

print("Negative Revenue rows:", (df['Revenue']<0).sum())
print(df[df['Revenue']<0][['Order_ID', 'Quantity','Selling_Price','Discount','Revenue']].head())

print("\nProfit_Margin > 1 (100%) rows:", (df['Profit_Margin'] > 1).sum())
print(df[df['Profit_Margin'] > 1][['Order_ID', 'Cost_Price', 'Selling_Price', 'Profit', 'Profit_Margin']].head())


df['Discount_Anomaly_Flag'] = df['Discount'] == 1.0
print("Flagged rows:", df['Discount_Anomaly_Flag'].sum())

df_clean = df[~df['Discount_Anomaly_Flag']]
df_clean['Order_Month'] = df_clean['Order_Date'].dt.to_period('M')
monthly_sales = df_clean.groupby('Order_Month').agg(
    Total_Revenue=('Revenue', 'sum'),
    Total_Orders=('Order_ID', 'count'),
    Total_Profit=('Profit', 'sum')
).reset_index()

print(monthly_sales)

import matplotlib.pyplot as plt

monthly_sales['Order_Month'] = monthly_sales['Order_Month'].astype(str)

fig, axes = plt.subplots(2, 1, figsize=(12, 8))

axes[0].plot(monthly_sales['Order_Month'], monthly_sales['Total_Revenue'], marker='o', color='steelblue')
axes[0].set_title('Monthly Revenue Trend')
axes[0].set_ylabel('Revenue')
axes[0].tick_params(axis='x', rotation=45)

axes[1].plot(monthly_sales['Order_Month'], monthly_sales['Total_Orders'], marker='o', color='darkorange')
axes[1].set_title('Monthly Order Count Trend')
axes[1].set_ylabel('Orders')
axes[1].tick_params(axis='x', rotation=45)

plt.tight_layout()
plt.savefig('monthly_trends.png', dpi=100)
plt.show()

top_products = df_clean.groupby('Product_Name').agg(
    Total_Revenue=('Revenue', 'sum'),
    Total_Quantity=('Quantity', 'sum')
).sort_values('Total_Revenue', ascending=False).head(10)
print("--- Top 10 Products by Revenue ---")
print(top_products)

category_sales = df_clean.groupby('Category').agg(
    Total_Revenue=('Revenue', 'sum'),
    Total_Orders=('Order_ID', 'count')
).sort_values('Total_Revenue', ascending=False)
print("\n--- Revenue by Category ---")
print(category_sales)

top_states = df_clean.groupby('State').agg(
    Total_Revenue=('Revenue', 'sum')
).sort_values('Total_Revenue', ascending=False).head(10)
print("\n--- Top 10 States by Revenue ---")
print(top_states)

fig, axes = plt.subplots(1, 3, figsize=(20, 6))

axes[0].barh(top_products.index[::-1], top_products['Total_Revenue'][::-1], color='teal')
axes[0].set_title('Top 10 Products by Revenue')
axes[0].set_xlabel('Revenue')

axes[1].bar(category_sales.index, category_sales['Total_Revenue'], color='coral')
axes[1].set_title('Revenue by Category')
axes[1].tick_params(axis='x', rotation=30)

axes[2].barh(top_states.index[::-1], top_states['Total_Revenue'][::-1], color='mediumpurple')
axes[2].set_title('Top 10 States by Revenue')
axes[2].set_xlabel('Revenue')

plt.tight_layout()
plt.savefig('top_performers.png', dpi=100)
plt.show()

# Payment mode distribution
payment_dist = df_clean['Payment_Mode'].value_counts()
print("--- Payment Mode Distribution ---")
print(payment_dist)

# Customer segment analysis
segment_sales = df_clean.groupby('Segment').agg(
    Total_Revenue=('Revenue', 'sum'),
    Total_Orders=('Order_ID', 'count')
).sort_values('Total_Revenue', ascending=False)
print("\n--- Revenue by Customer Segment ---")
print(segment_sales)

# Customer type (new vs returning, if that's what CUSTOMER_TYPE means)
customer_type_dist = df_clean['CUSTOMER_TYPE'].value_counts()
print("\n--- Customer Type Distribution ---")
print(customer_type_dist)

# Top 10 customers by revenue
top_customers = df_clean.groupby('Customer_Name').agg(
    Total_Revenue=('Revenue', 'sum'),
    Total_Orders=('Order_ID', 'count')
).sort_values('Total_Revenue', ascending=False).head(10)
print("\n--- Top 10 Customers by Revenue ---")
print(top_customers)

# Unique customers check
print("Unique Customer_IDs:", df_clean['Customer_ID'].nunique())
print("Unique Customer_Names:", df_clean['Customer_Name'].nunique())

# Top customers by ID (more reliable than name)
top_customers_id = df_clean.groupby(['Customer_ID', 'Customer_Name']).agg(
    Total_Revenue=('Revenue', 'sum'),
    Total_Orders=('Order_ID', 'count')
).sort_values('Total_Revenue', ascending=False).head(10)
print(top_customers_id)

# Charts
fig, axes = plt.subplots(1, 2, figsize=(14, 6))

axes[0].bar(payment_dist.index, payment_dist.values, color='seagreen')
axes[0].set_title('Orders by Payment Mode')
axes[0].tick_params(axis='x', rotation=30)

axes[1].bar(segment_sales.index, segment_sales['Total_Revenue'], color='goldenrod')
axes[1].set_title('Revenue by Customer Segment')

plt.tight_layout()
plt.savefig('customer_insights.png', dpi=100)
plt.show()

print("--- Delivery Status ---")
print(df_clean['Delivery_Status'].value_counts())

print("\n--- Delivery Performance ---")
print(df_clean['Delivery_Performance'].value_counts())

print("\n--- Delivery Days Summary ---")
print(df_clean['Delivery_Days'].describe())

print("\n--- 10 Slowest States (avg Delivery_Days) ---")
print(df_clean.groupby('State')['Delivery_Days'].mean().sort_values(ascending=False).head(10).round(2))

print("\n--- Rows with missing Delivery_Date ---")
missing = df_clean[df_clean['Delivery_Date'].isna()]
print(missing['Delivery_Status'].value_counts())
print(missing['Date_Issue_Flag'].value_counts())

# Delivery_Status vs Delivery_Performance
print(pd.crosstab(df_clean['Delivery_Status'], df_clean['Delivery_Performance']))

# Charts
fig, axes = plt.subplots(1, 3, figsize=(18, 5))

status_counts = df_clean['Delivery_Status'].value_counts()
axes[0].bar(status_counts.index, status_counts.values, color='steelblue')
axes[0].set_title('Delivery Status')
axes[0].tick_params(axis='x', rotation=20)

perf = df_clean['Delivery_Performance'].value_counts().reindex(['Fast', 'On Time', 'Late'])
axes[1].bar(perf.index, perf.values, color=['seagreen', 'gold', 'tomato'])
axes[1].set_title('Delivery Performance (Fast / On Time / Late)')

axes[2].hist(df_clean['Delivery_Days'].dropna(), bins=range(2, 14), color='darkorange', edgecolor='white')
axes[2].set_title('Delivery Days Distribution')
axes[2].set_xlabel('Days')

plt.tight_layout()
plt.savefig('delivery_performance.png', dpi=100)
plt.show()

# Profit by category
cat_profit = df_clean.groupby('Category').agg(
    Total_Revenue=('Revenue', 'sum'),
    Total_Profit=('Profit', 'sum')
)
cat_profit['Profit_Margin_%'] = (cat_profit['Total_Profit'] / cat_profit['Total_Revenue'] * 100).round(2)
print("--- Profit by Category ---")
print(cat_profit.sort_values('Total_Profit', ascending=False))

# Profit by sub-category (top 10 and bottom 5)
sub_profit = df_clean.groupby('Sub_Category').agg(
    Total_Revenue=('Revenue', 'sum'),
    Total_Profit=('Profit', 'sum')
)
sub_profit['Profit_Margin_%'] = (sub_profit['Total_Profit'] / sub_profit['Total_Revenue'] * 100).round(2)
sub_profit = sub_profit.sort_values('Total_Profit', ascending=False)
print("\n--- Top 10 Sub-Categories by Profit ---")
print(sub_profit.head(10))
print("\n--- Bottom 5 Sub-Categories by Profit ---")
print(sub_profit.tail(5))

# Discount vs profit
discount_impact = df_clean.groupby('Discount').agg(
    Orders=('Order_ID', 'count'),
    Total_Revenue=('Revenue', 'sum'),
    Total_Profit=('Profit', 'sum')
)
discount_impact['Profit_Margin_%'] = (discount_impact['Total_Profit'] / discount_impact['Total_Revenue'] * 100).round(2)
print("\n--- Discount vs Profit ---")
print(discount_impact)

fig, axes = plt.subplots(1, 2, figsize=(14, 6))

# Profit margin by category
cat_sorted = cat_profit.sort_values('Profit_Margin_%', ascending=False)
axes[0].bar(cat_sorted.index, cat_sorted['Profit_Margin_%'], color='slateblue')
axes[0].set_title('Profit Margin % by Category')
axes[0].set_ylabel('Profit Margin %')
axes[0].tick_params(axis='x', rotation=20)

# Discount vs margin
colors = ['seagreen' if m > 0 else 'crimson' for m in discount_impact['Profit_Margin_%']]
axes[1].bar([f"{round(d*100)}%" for d in discount_impact.index], discount_impact['Profit_Margin_%'], color=colors)
axes[1].axhline(0, color='black', linewidth=0.8)
axes[1].set_title('Profit Margin % by Discount Level')
axes[1].set_xlabel('Discount')
axes[1].set_ylabel('Profit Margin %')

plt.tight_layout()
plt.savefig('profit_discount.png', dpi=100)
plt.show()


import os
df.to_excel('cleaned_ecommerce_data.xlsx', index=False)
df.to_csv('cleaned_ecommerce_data.csv', index=False)
print("Saved in:", os.getcwd(), df.shape)